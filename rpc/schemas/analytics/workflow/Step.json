{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "Step.json",
  "title": "Step",
  "type": "object",
  "properties": {
    "__type": {
      "const": "step"
    },
    "metadata": {
      "$ref": "./StepMetadata.json"
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/InputDataSpec" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/OutputDataSpec" }
    },
    "task": {
      "$ref": "../tasks/TaskDefinition.json"
    },
    "environmentId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "__type",
    "metadata",
    "task",
    "environmentId"
  ],
  "additionalProperties": false,
  "$defs": {
    "InputDataSpec": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "schema": { "type": ["object", "null"], "additionalProperties": true },
        "location": { "type": "object", "additionalProperties": true },
        "stepRef": { "type": ["string", "null"] },
        "required": { "type": "boolean" },
        "constraints": { "type": ["object", "null"], "additionalProperties": true }
      },
      "required": [ "id", "name", "location" ],
      "additionalProperties": false
    },
    "OutputDataSpec": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "schema": { "type": ["object", "null"], "additionalProperties": true },
        "location": { "type": "object", "additionalProperties": true },
        "format": { "type": ["object", "null"], "additionalProperties": true }
      },
      "required": [ "id", "name", "location" ],
      "additionalProperties": false
    }
  }
}
